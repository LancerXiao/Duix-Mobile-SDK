<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header with gradient background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:paddingHorizontal="24dp">

        <!-- Top bar: settings icon + version -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="@string/settings"
                android:padding="4dp"
                app:tint="@color/text_on_primary" />

            <TextView
                android:id="@+id/tvSdkVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF"
                tools:text="SDK Version: 1.0.0" />
        </FrameLayout>

        <!-- App title -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_on_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Main content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Download tips -->
            <TextView
                android:id="@+id/tvDownloadTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_download_tips"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="20dp" />

            <!-- Model selection label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_url"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Model card: 小本 -->
            <LinearLayout
                android:id="@+id/cardModel1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_border_16"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <!-- Model avatar/icon placeholder -->
                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:layout_marginEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="小"
                        android:textSize="20sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Model info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvModel1Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/model_xiaoben"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModel1Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/model_not_downloaded"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Download button -->
                <TextView
                    android:id="@+id/btnModel1Download"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="72dp"
                    android:background="@drawable/bg_btn_download"
                    android:text="下载"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Selection checkmark -->
                <ImageView
                    android:id="@+id/ivModel1Check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="已选中"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Model card: 艾瑞克 -->
            <LinearLayout
                android:id="@+id/cardModel2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_border_16"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <!-- Model avatar/icon placeholder -->
                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:layout_marginEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="艾"
                        android:textSize="20sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Model info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvModel2Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/model_airuike"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModel2Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/model_not_downloaded"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Download button -->
                <TextView
                    android:id="@+id/btnModel2Download"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="72dp"
                    android:background="@drawable/bg_btn_download"
                    android:text="下载"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Selection checkmark -->
                <ImageView
                    android:id="@+id/ivModel2Check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="已选中"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Debug switch (less prominent) -->
            <LinearLayout
                android:id="@+id/layoutDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/debug_message"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDebug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom action area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <!-- Version update hint -->
        <TextView
            android:id="@+id/tvUpdateHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发现新版本，点击更新"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_model_hint"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_play_gradient"
            android:text="@string/play"
            android:textColor="@color/text_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>

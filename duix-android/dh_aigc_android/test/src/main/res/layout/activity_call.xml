<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <!-- Background image -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Digital human rendering - fullscreen -->
    <ai.guiji.duix.sdk.client.render.DUIXTextureView
        android:id="@+id/glTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Watermark cover: bottom 1/5 gradient -->
    <View
        android:id="@+id/watermarkCover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_watermark_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DH bottom gradient -->
    <View
        android:id="@+id/dhBottomGradient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_dh_bottom_gradient"
        app:layout_constraintBottom_toTopOf="@+id/watermarkCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tap overlay to interrupt speaking -->
    <View
        android:id="@+id/tapOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/watermarkCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tap ripple dot -->
    <View
        android:id="@+id/ivTapRipple"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_tap_ripple"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@+id/tapOverlay"
        app:layout_constraintBottom_toBottomOf="@+id/tapOverlay"
        app:layout_constraintStart_toStartOf="@+id/tapOverlay"
        app:layout_constraintEnd_toEndOf="@+id/tapOverlay" />

    <!-- Interrupt hint -->
    <TextView
        android:id="@+id/tvInterruptHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_interrupt_hint"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:text="Tap to interrupt"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <!-- Top toolbar - 56dp height, modern compact design -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button - 48dp touch target -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- New chat button -->
        <ImageView
            android:id="@+id/btnNewChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_new_chat"
            android:contentDescription="New chat"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Floating window toggle -->
        <ImageView
            android:id="@+id/btnFloating"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_floating_pin"
            android:contentDescription="Floating window"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="DUIX Digital Human"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Settings button -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Mute button -->
        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_pause"
            android:contentDescription="Mute"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Unmute button (hidden by default) -->
        <ImageView
            android:id="@+id/btnUnmute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            android:contentDescription="Unmute"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Status indicator pill -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Initializing..."
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Message list - larger max height for better readability -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="280dp"
        app:layout_constraintBottom_toTopOf="@+id/quickActionsScroll"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quick action chips row -->
    <HorizontalScrollView
        android:id="@+id/quickActionsScroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipGreet"
                style="@style/QuickActionChip"
                android:text="Say Hi" />

            <TextView
                android:id="@+id/chipJoke"
                style="@style/QuickActionChip"
                android:text="Tell a Joke" />

            <TextView
                android:id="@+id/chipPoem"
                style="@style/QuickActionChip"
                android:text="Fun Fact" />

            <TextView
                android:id="@+id/chipAdvice"
                style="@style/QuickActionChip"
                android:text="Advice" />

            <TextView
                android:id="@+id/chipTranslate"
                style="@style/QuickActionChip"
                android:text="Translate" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom panel - modern frosted glass style -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- State indicator row -->
        <LinearLayout
            android:id="@+id/stateIndicatorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_state_indicator"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivStateIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/white"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#DDFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ASR Fallback status -->
        <TextView
            android:id="@+id/tvFallbackStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="2dp"
            android:text=""
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- Error banner -->
        <TextView
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_error_banner"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Chat input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded EditText -->
            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="Type a message..."
                android:textColorHint="#77FFFFFF"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:enabled="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true" />

            <!-- Send button -->
            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_send_button"
                android:foreground="@drawable/selector_send_ripple"
                android:elevation="2dp"
                android:padding="11dp"
                android:src="@drawable/ic_send"
                android:contentDescription="Send"
                android:enabled="false"
                android:alpha="0.5"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Microphone button area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center">

            <!-- Recording pulse ring (outer) -->
            <View
                android:id="@+id/recordingPulseOuter"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_recording_pulse"
                android:visibility="gone" />

            <!-- Recording pulse ring (inner) -->
            <View
                android:id="@+id/recordingPulseInner"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_recording_outer"
                android:visibility="gone" />

            <!-- Mic button - 72dp for better touch target -->
            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button"
                android:foreground="@drawable/selector_mic_ripple"
                android:elevation="4dp"
                android:padding="18dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="Hold to speak"
                android:enabled="false"
                android:alpha="0.5"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- Mic button label -->
        <TextView
            android:id="@+id/tvMicLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="Hold to speak"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_loading_overlay"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Initializing..."
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLoadingDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#BBFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_mic_button"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Retry"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

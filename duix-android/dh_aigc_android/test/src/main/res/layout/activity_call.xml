<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <!-- Background image -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Digital human rendering (full screen) -->
    <ai.guiji.duix.sdk.client.render.DUIXTextureView
        android:id="@+id/glTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Tap overlay to interrupt speaking -->
    <View
        android:id="@+id/tapOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/messagesList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- [P2-A] 点击数字人打断时的涟漪圆点：60dp 圆形，淡出+放大 200ms -->
    <View
        android:id="@+id/ivTapRipple"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_tap_ripple"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@+id/tapOverlay"
        app:layout_constraintBottom_toBottomOf="@+id/tapOverlay"
        app:layout_constraintStart_toStartOf="@+id/tapOverlay"
        app:layout_constraintEnd_toEndOf="@+id/tapOverlay" />

    <!-- 打断提示 (Phase 2.5) - SPEAKING 时显示在数字人上方 -->
    <TextView
        android:id="@+id/tvInterruptHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_interrupt_hint"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:text="👆 点击数字人打断"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <!-- Top toolbar - semi-transparent -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="返回"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- [Phase 7.2 P0-4] New chat button -->
        <ImageView
            android:id="@+id/btnNewChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_new_chat"
            android:contentDescription="新建对话"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- [P2-C] 悬浮窗开关：点击启动/关闭可拖拽悬浮窗 -->
        <ImageView
            android:id="@+id/btnFloating"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_floating_pin"
            android:contentDescription="悬浮窗"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="DUIX 数字人"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- ASR 引擎指示器 (可点击切换) - Phase 1.2 骨架 -->
        <TextView
            android:id="@+id/tvAsrEngine"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="56dp"
            android:gravity="center"
            android:background="@drawable/bg_tts_engine_selector"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Dash"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="点击切换ASR引擎"
            android:layout_marginEnd="6dp" />

        <!-- TTS引擎指示器 (可点击切换) -->
        <TextView
            android:id="@+id/tvTtsEngine"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="56dp"
            android:gravity="center"
            android:background="@drawable/bg_tts_engine_selector"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Qwen TTS"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="点击切换TTS引擎"
            android:layout_marginEnd="6dp" />

        <!-- Mute button -->
        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_pause"
            android:contentDescription="静音"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Unmute button (hidden by default) -->
        <ImageView
            android:id="@+id/btnUnmute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            android:contentDescription="取消静音"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Status indicator (small, below toolbar) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#80000000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="初始化中..."
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AI Response chat bubble - Phase 2.2 改为 RecyclerView 多轮历史 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chat_bubble"
        android:padding="8dp"
        android:visibility="visible"
        android:maxHeight="320dp"
        app:layout_constraintHeight_max="320dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 数字人底部渐变：让数字人和消息区域视觉平滑过渡（豆包风格） -->
    <View
        android:id="@+id/dhBottomGradient"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_dh_bottom_gradient"
        app:layout_constraintBottom_toTopOf="@+id/messagesList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- [Phase 4.3 P1-1] 快捷指令 chip 行：用户上手成本↓70% -->
    <HorizontalScrollView
        android:id="@+id/quickActionsScroll"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipGreet"
                style="@style/QuickActionChip"
                android:text="👋 打个招呼" />

            <TextView
                android:id="@+id/chipJoke"
                style="@style/QuickActionChip"
                android:text="😄 讲个笑话" />

            <TextView
                android:id="@+id/chipPoem"
                style="@style/QuickActionChip"
                android:text="📖 背首古诗" />

            <TextView
                android:id="@+id/chipAdvice"
                style="@style/QuickActionChip"
                android:text="💡 给我建议" />

            <TextView
                android:id="@+id/chipTranslate"
                style="@style/QuickActionChip"
                android:text="🌐 翻译一下" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom panel -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_panel"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 当前状态图标行 (Phase 2.3 加大可视权重) -->
        <LinearLayout
            android:id="@+id/stateIndicatorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_state_indicator"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivStateIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/white"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvStateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="就绪"
                android:textColor="#EEFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ASR Fallback 状态行 (Phase 1.3 骨架) - 显示最近一次 ASR 错误的 fallback 决策 -->
        <TextView
            android:id="@+id/tvFallbackStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"
            android:text=""
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 错误提示 Banner (Phase 2.4) - 顶部条状，3秒自动消失 -->
        <TextView
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_error_banner"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Chat input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded EditText -->
            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="输入消息..."
                android:textColorHint="#99FFFFFF"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:enabled="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true" />

            <!-- Send button -->
            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_button"
                android:foreground="@drawable/selector_send_ripple"
                android:elevation="3dp"
                android:padding="8dp"
                android:src="@drawable/ic_send"
                android:contentDescription="发送"
                android:enabled="false"
                android:alpha="0.5"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Microphone button area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <!-- Recording pulse ring (outer) -->
            <View
                android:id="@+id/recordingPulseOuter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_recording_pulse"
                android:visibility="gone" />

            <!-- Recording pulse ring (inner) -->
            <View
                android:id="@+id/recordingPulseInner"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_recording_outer"
                android:visibility="gone" />

            <!-- Mic button -->
            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button"
                android:foreground="@drawable/selector_mic_ripple"
                android:elevation="6dp"
                android:padding="14dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="按住说话"
                android:enabled="false"
                android:alpha="0.5"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- Mic button label -->
        <TextView
            android:id="@+id/tvMicLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="按住说话"
            android:textColor="#BBFFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/white" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="正在初始化..."
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLoadingDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#BBFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_mic_button"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="重试"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

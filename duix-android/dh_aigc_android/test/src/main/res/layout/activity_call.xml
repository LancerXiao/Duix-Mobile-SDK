<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <!-- Background image -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Digital human rendering - 全屏渲染，UI 叠加在上面 -->
    <ai.guiji.duix.sdk.client.render.DUIXTextureView
        android:id="@+id/glTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 水印遮盖层：覆盖底部 1/5 区域，完全遮挡右下角水印 -->
    <View
        android:id="@+id/watermarkCover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0D0D1A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 数字人底部渐变：让数字人和水印遮盖层视觉平滑过渡 -->
    <View
        android:id="@+id/dhBottomGradient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_dh_bottom_gradient"
        app:layout_constraintBottom_toTopOf="@+id/watermarkCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tap overlay to interrupt speaking - 覆盖数字人可见区域 -->
    <View
        android:id="@+id/tapOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/watermarkCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 点击数字人打断时的涟漪圆点 -->
    <View
        android:id="@+id/ivTapRipple"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_tap_ripple"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@+id/tapOverlay"
        app:layout_constraintBottom_toBottomOf="@+id/tapOverlay"
        app:layout_constraintStart_toStartOf="@+id/tapOverlay"
        app:layout_constraintEnd_toEndOf="@+id/tapOverlay" />

    <!-- 打断提示 - SPEAKING 时显示在数字人上方 -->
    <TextView
        android:id="@+id/tvInterruptHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_interrupt_hint"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center"
        android:text="点击数字人打断"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />

    <!-- Top toolbar - 紧凑毛玻璃风格 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_back"
            android:contentDescription="返回"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- New chat button -->
        <ImageView
            android:id="@+id/btnNewChat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_new_chat"
            android:contentDescription="新建对话"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- 悬浮窗开关 -->
        <ImageView
            android:id="@+id/btnFloating"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_floating_pin"
            android:contentDescription="悬浮窗"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="DUIX 数字人"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 设置按钮：点击弹出 ASR/TTS 设置弹窗 -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_marginEnd="2dp" />

        <!-- Mute button -->
        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_pause"
            android:contentDescription="静音"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <!-- Unmute button (hidden by default) -->
        <ImageView
            android:id="@+id/btnUnmute"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_play"
            android:contentDescription="取消静音"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Status indicator - 更紧凑的药丸样式 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="初始化中..."
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 消息列表 - 紧凑浮层，不挡数字人脸部 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:clipToPadding="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="120dp"
        app:layout_constraintBottom_toTopOf="@+id/quickActionsScroll"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 快捷指令 chip 行 -->
    <HorizontalScrollView
        android:id="@+id/quickActionsScroll"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipGreet"
                style="@style/QuickActionChip"
                android:text="打个招呼" />

            <TextView
                android:id="@+id/chipJoke"
                style="@style/QuickActionChip"
                android:text="讲个笑话" />

            <TextView
                android:id="@+id/chipPoem"
                style="@style/QuickActionChip"
                android:text="背首古诗" />

            <TextView
                android:id="@+id/chipAdvice"
                style="@style/QuickActionChip"
                android:text="给我建议" />

            <TextView
                android:id="@+id/chipTranslate"
                style="@style/QuickActionChip"
                android:text="翻译一下" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom panel - 紧凑毛玻璃风格 -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_panel"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 状态图标行 -->
        <LinearLayout
            android:id="@+id/stateIndicatorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_state_indicator"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivStateIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/white"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="就绪"
                android:textColor="#DDFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ASR Fallback 状态行 -->
        <TextView
            android:id="@+id/tvFallbackStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="2dp"
            android:text=""
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- 错误提示 Banner -->
        <TextView
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_error_banner"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Chat input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded EditText -->
            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="输入消息..."
                android:textColorHint="#77FFFFFF"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:enabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true" />

            <!-- Send button -->
            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_send_button"
                android:foreground="@drawable/selector_send_ripple"
                android:elevation="2dp"
                android:padding="7dp"
                android:src="@drawable/ic_send"
                android:contentDescription="发送"
                android:enabled="false"
                android:alpha="0.5"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Microphone button area - 紧凑版 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <!-- Recording pulse ring (outer) -->
            <View
                android:id="@+id/recordingPulseOuter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_recording_pulse"
                android:visibility="gone" />

            <!-- Recording pulse ring (inner) -->
            <View
                android:id="@+id/recordingPulseInner"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_recording_outer"
                android:visibility="gone" />

            <!-- Mic button -->
            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button"
                android:foreground="@drawable/selector_mic_ripple"
                android:elevation="4dp"
                android:padding="12dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="按住说话"
                android:enabled="false"
                android:alpha="0.5"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- Mic button label -->
        <TextView
            android:id="@+id/tvMicLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:text="按住说话"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/white" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="正在初始化..."
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLoadingDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#BBFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_mic_button"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="重试"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

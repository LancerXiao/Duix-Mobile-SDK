<?xml version="1.0" encoding="utf-8"?>
<!-- ASR/TTS 引擎设置底部弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_panel"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="语音引擎设置"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close_white"
            android:contentDescription="关闭"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

    <!-- ASR 引擎选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="语音识别 (ASR)"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnAsrDashscope"
            style="@style/EngineChip"
            android:text="DashScope" />

        <TextView
            android:id="@+id/btnAsrAndroid"
            style="@style/EngineChip"
            android:text="Android" />

    </LinearLayout>

    <!-- TTS 引擎选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="语音合成 (TTS)"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTtsEdge"
            style="@style/EngineChip"
            android:text="Edge TTS" />

        <TextView
            android:id="@+id/btnTtsQwen"
            style="@style/EngineChip"
            android:text="Qwen TTS" />

        <TextView
            android:id="@+id/btnTtsAndroid"
            style="@style/EngineChip"
            android:text="Android" />

    </LinearLayout>

    <!-- 当前选择提示 -->
    <TextView
        android:id="@+id/tvEngineInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text=""
        android:textColor="#77FFFFFF"
        android:textSize="11sp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="#1AFFFFFF" />

    <!-- 端到端自测按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSelfTest"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="文本自测"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSelfTestWithAsr"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="ASR自测"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSelfTestTtsStress"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="TTS压力"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSelfTestRapid"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="快速5轮"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="自动模拟用户对话，验证全链路稳定性"
        android:textColor="#55FFFFFF"
        android:textSize="10sp" />

</LinearLayout>

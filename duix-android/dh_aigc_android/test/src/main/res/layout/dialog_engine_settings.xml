<?xml version="1.0" encoding="utf-8"?>
<!-- ASR/TTS/LLM 引擎设置底部弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_panel"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Voice Engine Settings"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close_white"
            android:contentDescription="Close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

    <!-- LLM 引擎选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Language Model (LLM)"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnLlmMimo"
            style="@style/EngineChip"
            android:text="MiMo" />

        <TextView
            android:id="@+id/btnLlmAgnes"
            style="@style/EngineChip"
            android:text="Agnes" />

    </LinearLayout>

    <!-- ASR 引擎选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speech Recognition (ASR)"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnAsrDashscope"
            style="@style/EngineChip"
            android:text="DashScope" />

        <TextView
            android:id="@+id/btnAsrAndroid"
            style="@style/EngineChip"
            android:text="Android" />

    </LinearLayout>

    <!-- TTS 引擎选择 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Text-to-Speech (TTS)"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTtsQwen"
            style="@style/EngineChip"
            android:text="Qwen" />

        <TextView
            android:id="@+id/btnTtsMimo"
            style="@style/EngineChip"
            android:text="MiMo" />

        <TextView
            android:id="@+id/btnTtsEdge"
            style="@style/EngineChip"
            android:text="Edge" />

        <TextView
            android:id="@+id/btnTtsAndroid"
            style="@style/EngineChip"
            android:text="Android" />

    </LinearLayout>

    <!-- 当前选择提示 -->
    <TextView
        android:id="@+id/tvEngineInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text=""
        android:textColor="#77FFFFFF"
        android:textSize="11sp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="#1AFFFFFF" />

    <!-- 端到端自测按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSelfTest"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="Text Test"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSelfTestWithAsr"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="ASR Test"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSelfTestTtsStress"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="TTS Stress"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSelfTestRapid"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="Quick 5"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSelfTestHistory"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Test Log"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_engine_chip"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Auto-simulate conversations to verify pipeline stability"
        android:textColor="#55FFFFFF"
        android:textSize="10sp" />

</LinearLayout>

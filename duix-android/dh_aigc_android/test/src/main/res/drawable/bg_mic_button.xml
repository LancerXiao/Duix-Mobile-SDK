<?xml version="1.0" encoding="utf-8"?>
<!-- Mic button: violet-cyan gradient oval -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Main gradient -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#7C3AED"
                android:endColor="#06B6D4" />
        </shape>
    </item>
</layer-list>

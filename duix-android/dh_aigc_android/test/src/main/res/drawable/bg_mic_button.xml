<?xml version="1.0" encoding="utf-8"?>
<!-- 麦克风按钮：蓝青品牌色径向渐变 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈阴影层 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- 主体品牌渐变 -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60"
                android:startColor="#FF00D4FF"
                android:endColor="#FF0099CC" />
        </shape>
    </item>
</layer-list>

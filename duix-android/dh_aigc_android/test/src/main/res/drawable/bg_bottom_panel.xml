<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom panel: gradient dark + 32dp top corners + glow top border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#E60A0A1A"
                android:endColor="#F206060F" />
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Top glow border -->
    <item
        android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1.5dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#007C3AED"
                android:centerColor="#667C3AED"
                android:endColor="#007C3AED" />
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
        </shape>
    </item>
</layer-list>

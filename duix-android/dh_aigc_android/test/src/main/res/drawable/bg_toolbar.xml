<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar: frosted glass dark + bottom gradient glow line -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0A0A1A" />
        </shape>
    </item>
    <item
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1.5dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#007C3AED"
                android:centerColor="#557C3AED"
                android:endColor="#007C3AED" />
        </shape>
    </item>
</layer-list>

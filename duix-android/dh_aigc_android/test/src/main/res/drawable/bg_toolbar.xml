<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar: frosted glass + violet-cyan gradient glow border at bottom -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main background: frosted glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0A0A1A" />
        </shape>
    </item>
    <!-- Bottom gradient glow border -->
    <item
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1.5dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#007C3AED"
                android:centerColor="#AA7C3AED"
                android:endColor="#0006B6D4" />
        </shape>
    </item>
</layer-list>
